            ]
          }
          contract: {
            id: "GET /api/uuid"
            json: "{\"operationId\":\"generateUUID\",\"parameters\":[{\"description\":\"Number of UUIDs to generate\",\"in\":\"query\",\"name\":\"count\",\"required\":false,\"schema\":{\"default\":1,\"maximum\":100,\"minimum\":1,\"type\":\"integer\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"uuids\":{\"items\":{\"format\":\"uuid\",\"type\":\"string\"},\"type\":\"array\"}},\"type\":\"object\"}}},\"description\":\"Successfully generated UUID(s)\"}},\"securitySchemes\":{},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
