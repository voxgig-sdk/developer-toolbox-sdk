# Entity: url_tool

main: kit: entity: url_tool: {

  alias: field: {}

  fields: [
    {
      name: "customAlias"
      req: false
      short: "Custom alias for shortened URL"
      type: "`$STRING`"
    }
    {
      name: "originalUrl"
      req: false
      type: "`$STRING`"
    }
    {
      name: "shortUrl"
      req: false
      type: "`$STRING`"
    }
    {
      name: "url"
      req: true
      short: "URL to shorten"
      type: "`$STRING`"
    }
  ]

  name: "url_tool"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/api/url/shorten"
          parts: [
            "api"
            "url"
            "shorten"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
